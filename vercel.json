{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/admin run build",
  "outputDirectory": "artifacts/admin/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "devCommand": "pnpm --filter @workspace/admin run dev",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
