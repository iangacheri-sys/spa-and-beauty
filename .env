# ─── BeautyBooker Local Development .env ─────────────────────────────────────
# Auto-generated for local dev without Docker. Uses local PostgreSQL if available.
# If you have PostgreSQL running locally, update DATABASE_URL below.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://beautybooker:beautybooker_dev@localhost:5432/beautybooker

# ─── API Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-secret-key-minimum-32-characters-for-local-development

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://192.168.54.128:5173

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ─── Mobile App ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://192.168.8.39:5000

# ─── AI Integrations ──────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── M-Pesa Integration ───────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=http://your-ngrok-url/api/webhooks/mpesa
