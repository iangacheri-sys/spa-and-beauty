# ═════════════════════════════════════════════════════════════════════════════
# Dockerfile.admin — Production image for the Beauty Booker Admin Dashboard
# Target: Railway Docker deployment
# Strategy: 2-stage multi-stage build
#   1. builder — Install deps + Vite build
#   2. runner  — nginx serving static files (no Node.js at runtime!)
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: builder
# Installs workspace dependencies and runs the Vite production build.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-slim AS builder

WORKDIR /app

# Install pnpm directly via npm — bypasses the corepack ERR_VM_DYNAMIC_IMPORT bug
RUN npm install -g pnpm@9.15.0

# Copy workspace configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Copy every package.json in the workspace (pnpm needs the full dep graph)
COPY lib/api-zod/package.json              ./lib/api-zod/
COPY lib/api-spec/package.json             ./lib/api-spec/
COPY lib/db/package.json                   ./lib/db/
COPY lib/api-client-react/package.json     ./lib/api-client-react/
COPY artifacts/api-server/package.json     ./artifacts/api-server/
COPY artifacts/admin/package.json          ./artifacts/admin/
COPY artifacts/mobile/package.json         ./artifacts/mobile/
COPY artifacts/mockup-sandbox/package.json ./artifacts/mockup-sandbox/
COPY scripts/package.json                  ./scripts/

# Override minimumReleaseAge — Replit-specific setting that breaks Docker builds
RUN sed -i 's/minimumReleaseAge: 1440/minimumReleaseAge: 0/' pnpm-workspace.yaml

# Install all workspace dependencies (frozen for deterministic builds)
RUN pnpm install --frozen-lockfile

# Copy all source code
COPY . .

# Re-apply minimumReleaseAge override (COPY . . overwrites pnpm-workspace.yaml)
RUN sed -i 's/minimumReleaseAge: 1440/minimumReleaseAge: 0/' pnpm-workspace.yaml

# Build the admin dashboard
# Output: artifacts/admin/dist/
RUN pnpm --filter @workspace/admin run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: runner
# Minimal nginx image. No Node.js at runtime — just static files + nginx.
# Final image is ~25MB.
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Copy the built static files into the nginx document root
COPY --from=builder /app/artifacts/admin/dist /usr/share/nginx/html

# Copy our nginx configuration (SPA fallback, caching, compression)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
