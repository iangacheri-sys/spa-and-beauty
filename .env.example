# ─── BeautyBooker Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=beautybooker
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=beautybooker

# ─── API Server ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://beautybooker:your_strong_password_here@localhost:5432/beautybooker
PORT=5000
NODE_ENV=development

# ─── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_char_random_hex_string_in_production_!!

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes in milliseconds
RATE_LIMIT_MAX=100            # Max requests per window per IP

# ─── Payments (M-Pesa) ─────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_safaricom_consumer_key
MPESA_CONSUMER_SECRET=your_safaricom_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback

# ─── Mobile App ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:5000
